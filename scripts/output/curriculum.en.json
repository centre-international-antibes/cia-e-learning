{
  "levels": {
    "A1": {
      "title": "Discovery",
      "objective": "Understand and use familiar everyday expressions. Introduce oneself and ask simple questions."
    },
    "A2": {
      "title": "Survival",
      "objective": "Understand frequently used expressions. Communicate during simple tasks. Describe one's environment."
    },
    "B1": {
      "title": "Threshold",
      "objective": "Get by in most travel situations. Talk about things, express a wish, give reasons."
    },
    "B2": {
      "title": "Advanced",
      "objective": "Understand the main content of concrete or abstract topics. Express oneself clearly and in detail."
    },
    "C1": {
      "title": "Proficient User",
      "objective": "Understand long and demanding texts. Express oneself spontaneously and fluently. Use the language flexibly and effectively."
    },
    "C2": {
      "title": "Mastery",
      "objective": "Effortlessly understand almost everything. Express yourself spontaneously, very fluently, and precisely."
    }
  },
