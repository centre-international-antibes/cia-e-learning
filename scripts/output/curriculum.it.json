{
  "levels": {
    "A1": {
      "title": "Scoperta",
      "objective": "Comprendere e utilizzare espressioni familiari e quotidiane. Presentarsi e fare domande semplici."
    },
    "A2": {
      "title": "Sopravvivenza",
      "objective": "Comprendere espressioni di uso frequente. Comunicare in situazioni semplici. Descrivere il proprio ambiente."
    },
    "B1": {
      "title": "Soglia",
      "objective": "Cavarsela nella maggior parte delle situazioni di viaggio. Raccontare, esprimere un desiderio, dare ragioni."
    },
    "B2": {
      "title": "Avanzato",
      "objective": "Comprendere il contenuto essenziale di argomenti concreti o astratti. Esprimersi in modo chiaro e dettagliato."
    },
    "C1": {
      "title": "Autonomo",
      "objective": "Comprendere testi lunghi ed esigenti. Esprimersi spontaneamente e fluentemente. Usare la lingua in modo flessibile ed efficace."
    },
    "C2": {
      "title": "Padronanza",
      "objective": "Comprendere senza sforzo praticamente tutto. Esprimersi spontaneamente, con grande fluidità e precisione."
    }
  },
